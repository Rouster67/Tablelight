{
  "name": "tablelight",
  "productName": "Tablelight",
  "version": "1.9.2",
  "description": "A local dungeon master console and transparent tabletop HUD.",
  "main": "main.js",
  "private": true,
  "license": "GPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Rouster67/Tablelight.git"
  },
  "bugs": {
    "url": "https://github.com/Rouster67/Tablelight/issues"
  },
  "author": "Tablelight contributors",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.js",
    "test:native": "node scripts/test-native.cjs",
    "check": "node scripts/check.cjs && node --test tests/*.test.js",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build:windows": "node scripts/build-windows.cjs"
  },
  "devDependencies": {
    "electron": "44.3.0",
    "prettier": "3.6.2"
  }
}
